{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../../HCloudAPI",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "../_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
        ]
      }
    ],
    "output": "../_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "HCloudAPI",
      "_appTitle": "HCloudAPI",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true,
      "_lang": "en",
      "_gitContribute": {
        "repo": "https://github.com/Skorplul/HCloudAPI",
        "branch": "dev"
        },
      "pdf": true
    }
  }
}
